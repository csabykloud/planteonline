    "html": "<br /><br><div align=\"justify\"><table style=\"padding: 0px;\" width=\"100%\"><tbody><tr><td width=\"255\"><table style=\"padding: 0px;\" width=\"255\"><tbody><tr><td class=\"otext12b\" height=\"23\">  </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td class=\"btext10\"><img src=\"http://www.planteonline.ro/img/framework/arrow.jpg\" /> <a href=\"http://www.planteonline.ro/index.php?pn=indoor_plant_detailed_box&amp;id_plant=454\" class=\"text10b_noline\"> Adiantum raddianum</a>\r\n <img src=\"http://www.planteonline.ro/img/framework/arrow.jpg\" /> <a href=\"http://www.planteonline.ro/index.php?pn=indoor_plant_detailed_box&amp;id_plant=462\" class=\"text10b_noline\"> Chrysalidocarpus lutenscens</a>\r\n</td>\r\n                    </tr>\r\n\r\n                    <tr>\r\n                        <td class=\"otext12b\" height=\"23\"> A</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td class=\"btext10\"><img src=\"http://www.planteonline.ro/img/framework/arrow.jpg\" /> <a href=\"http://www.planteonline.ro/index.php?pn=indoor_plant_detailed_box&amp;id_plant=56\" class=\"text10b_noline\">Anthurium scherzerianum</a>\r\n <img src=\"http://www.planteonline.ro/img/framework/arrow.jpg\" /> <a href=\"http://www.planteonline.ro/index.php?pn=indoor_plant_detailed_box&amp;id_plant=58\" class=\"text10b_noline\">Araucaria heterophylla</a>\r\n <img src=\"http://www.planteonline.ro/img/framework/arrow.jpg\" /> <a href=\"http://www.planteonline.ro/index.php?pn=indoor_plant_detailed_box&amp;id_plant=59\" class=\"text10b_noline\">Asparagus setaceus</a>\r\n <img src=\"http://www.planteonline.ro/img/framework/arrow.jpg\" /> <a href=\"http://www.planteonline.ro/index.php?pn=indoor_plant_detailed_box&amp;id_plant=55\" class=\"text10b_noline\">Ananas comosus 'Variegatus'</a>\r\n <img src=\"http://www.planteonline.ro/img/framework/arrow.jpg\" /> <a href=\"http://www.planteonline.ro/index.php?pn=in