" name=\"medium grid 2 accent 6\">    </w:lsdexception><w:lsdexception locked=\"false\" priority=\"69\" semihidden=\"false\" unhidewhenused=\"false\" name=\"medium grid 3 accent 6\">    </w:lsdexception><w:lsdexception locked=\"false\" priority=\"70\" semihidden=\"false\" unhidewhenused=\"false\" name=\"dark list accent 6\">    </w:lsdexception><w:lsdexception locked=\"false\" priority=\"71\" semihidden=\"false\" unhidewhenused=\"false\" name=\"colorful shading accent 6\">    </w:lsdexception><w:lsdexception locked=\"false\" priority=\"72\" semihidden=\"false\" unhidewhenused=\"false\" name=\"colorful list accent 6\">    </w:lsdexception><w:lsdexception locked=\"false\" priority=\"73\" semihidden=\"false\" unhidewhenused=\"false\" name=\"colorful grid accent 6\">    </w:lsdexception><w:lsdexception locked=\"false\" priority=\"19\" semihidden=\"false\" unhidewhenused=\"false\" qformat=\"true\" name=\"subtle emphasis\">    </w:lsdexception><w:lsdexception locked=\"false\" priority=\"21\" semihidden=\"false\" unhidewhenused=\"false\" qformat=\"true\" name=\"intense emphasis\">    </w:lsdexception><w:lsdexception locked=\"false\" priority=\"31\" semihidden=\"false\" unhidewhenused=\"false\" qformat=\"true\" name=\"subtle reference\">    </w:lsdexception><w:lsdexception locked=\"false\" priority=\"32\" semihidden=\"false\" unhidewhenused=\"false\" qformat=\"true\" name=\"intense reference\">    </w:lsdexception><w:lsdexception locked=\"false\" priority=\"33\" semihidden=\"false\" unhidewhenused=\"false\" qformat=\"true\" name=\"book title\">    </w:lsdexception><w:lsdexception locked=\"false\" priority=\"37\" name=\"bibliography\">    </w:lsdexception><w:lsdexception locked=\"false\" priority=\"39\" qformat=\"true\" name=\"toc heading\">   </w:lsdexception>  </w:lsdexception>    </w:lsdexception></w:lsdexception></w:lsdexception></w:latentstyles></xml></m:defjc></m:rmargin></m:lmargin></m:dispdef></m:smallfrac></m:brkbinsub></m:brkbin></m:mathfont></m:mathpr></w:word11kerningpairs></w:dontvertalignintxbx></w:dontbreakconstrainedforcedtables></w:dontvertaligncellwithsp></w:splitpgbreakandparamark></w:dontgrowautofit></w:useasianbreakrules></w:wraptextwithpunct></w:snaptogridincell></w:breakwrappedtables></w:compatibility></w:donotpromoteqf></w:validateagainstschemas></w:punctuationkerning></w:trackformatting></w:trackmoves></w:worddocument></xml></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:lsdexception></w:latentstyles></xml></m:defjc></m:rmargin></m:lmargin></m:dispdef></m:smallfrac></m:brkbinsub></m:brkbin></m:mathfont></m:mathpr></w:word11kerningpairs></w:dontvertalignintxbx></w:dontbreakconstrainedforcedtables></w:dontvertaligncellwithsp></w:splitpgbreakandparamark></w:dontgrowautofit></w:useasianbreakrules></w:wraptextwithpunct></w:snaptogridincell></w:breakwrappedtables></w:compatibility></w:donotpromoteqf></w:validateagainstschemas></w:punctuationkerning></w:trackformatting></w:trackmoves></w:worddocument></xml></a><span style=\"font-size: small;\"><a name=\"art_\">Nimic nu poate concura cu  aroma unui fruct proaspÄt cules din livadÄ. Pe lĂŽngÄ gust, fructele  conĹŁin mai multe vitamine Ĺi elemente necesare pentru corpul uman. Din  aceastÄ cauzÄ, majoritatea oamenilor au ĂŽn grÄdinÄ mai mulĹŁi pomi  fructiferi. Cele mai rÄspĂŽndite fiind mÄrul, prunul, parul, cireĹul Ĺi  viĹinul.<br />        Plantarea pomilor nu este suficientÄ pentru  obĹŁinerea produsului. Pentru obĹŁinerea unei recolte sĂŽnt necesare  cĂŽteva procese de ĂŽntreĹŁinere.<br />         Majoritatea lucrÄrilor se fac primÄvara. Primul pas recomandat  este sÄ ne facem un plan. Este important sÄ procurÄm din timp soluĹŁiile Ĺi sculele necesare pentru ĂŽntreĹŁinerea livadei. Deasemenea este  important verificarea Ĺi repararea utilajelor ce vom folosi ĂŽn cursul  anului. Ăn februarie putem sÄ ne apucÄm de tÄierea la rod a mÄrului, a  coacÄzei Ĺi zmeurei, cu condiĹŁia ca temperatura sÄ ne permitÄ. Se poate  aplica Ĺi prima pulverizare ĂŽmpotriva  microbilor Ĺi insectelor  dÄunÄtoare. Ăn martie se poate face ĂŽngrÄĹarea Ĺi prelucrarea solului.  Deasemenea primÄvara este perioada cĂŽnd se poate da cu var pe trunchiul  pomilor, pentru a preveni bolile.<br />         Cel mai important proces este tÄierea la rod. Poate fi fÄcut ĂŽn  mai multe feluri, ĂŽn funcĹŁie de rezultatul dorit. Se poate face prin  tÄierea ramurilor pĂŽnÄ la baza, iar rezultatul se va vedea ĂŽn  cantitatea recoltei. Se poate face prin tÄierea parĹŁialÄ a  ramurelor,cea ce favorizeazÄ creĹterea vegetativÄ a plantei. Este  recomandat ca crengile mai vechi de patru ani sÄ fie tÄiate, pentru ĂŽntinerirea pÄrĹŁii roditoare.<br />         Este foarte important Ĺi momentul tÄierii la rod. Se poate face  tÄierea la rod a pÄrĹŁii lemnoase Ĺi a pÄrĹŁii verzi.TÄierea la rod a  pÄrĹŁii lemnoase  se face ĂŽn perioada de repaus a pomului.Trebuie avut ĂŽnsÄ grijÄ ca temperatura sÄ nu fie foarte scÄzutÄ, pentru cÄ se poate ĂŽngheĹŁa pomul.TÄierea pÄrĹŁii lemnoase ajutÄ la creĹterea vegetativÄ a  plantei, iar tÄierea pÄrĹŁii verzi, stopeazÄ creĹterea. Ăntrebarea este  cÄ dacÄ sĂŽnt lucruri contrare, de ce trebuie fÄcute amĂŽndouÄ. Deja Ĺtim  de ce trebuie fÄcut tÄierea pÄrĹŁii lemnoase. Perioada de tÄiere a  pÄrĹŁii verzi se face ĂŽn timpul cĂŽt se dezvoltÄ coroana pomului. PÄrĹŁile  care nu aduc roade, trebuie scurtate pentru a nu aspira substanĹŁele  nutritive de la pÄrĹŁile productive. Deci prin tÄierea pÄrĹŁilor verzi,  reuĹim sÄ asigurÄm o cantitate mai mare de substanĹŁÄ nutritivÄ pÄrĹŁilor  productive.<br />         TÄierea la rod se foloseĹte Ĺi pentru a rÄrii coroana, pentru a  asigura intrarea razelor solare Ĺi la fructele aflate ĂŽn interiorul  coroanei.<br />         TÄiarea la rod pentru mÄr, este recomandat cĂŽnd ĂŽncep sÄ se  deschidÄ mugurii Ĺi ĹŁine pĂŽnÄ aceĹtia se deschid ĂŽn totalitate.TÄierea  pÄrĹŁii lemnoase se face Ĺi ĂŽn perioada iernii Ĺi poate fi folosit  pentru ĂŽntinerirea pÄrĹŁii productive Ĺi pentru determinarea cantitÄĹŁii Ĺi mÄrimii produsului.TÄierea de varÄ se face din a doua parte a lunii  august, Ĺi se terminÄ cu douÄ sÄptÄmĂŽni ĂŽnaintea culesului.<br />          La pere situaĹŁia este un pic altfel. La soiurile la care cresc  ramuri lungi (Bosc, Clapp, Diel), este obligatoriu tÄierea la rod. La  soiurile la care coroana este prea densÄ (Vilmos,Hardenpont) este nevoie  de rÄrirea coroanei. Ramurele sub 10 cm se pÄstreazÄ, fiindcÄ din  acestea cresc pÄrĹŁile producÄtoare. Ăn iulie, cĂŽnd ramurile verzi sĂŽnt  de grosimea unui creion, tÄiem pĂŽnÄ rÄmĂŽn 2-3 frunze pe ea. Ramurele  mai subĹŁiri vor fi tÄiate ĂŽn luna VIII-IX. Prin acest lucru ajungem la ĂŽnmulĹŁirea zonei productive.<br />         CireĹele se taie la rod pe la sfĂŽrĹitul primÄverii, Ănaintea  deschiderii mugurilor.CireĹele se poate infecta ĂŽn urma rÄnilor, dacÄ  se aflÄ ĂŽntr-o perioadÄ ploioasÄ. Pentru a evita infectarea, tÄierea sÄ  facem ĂŽntr-o perioadÄ uscatÄ.TÄierea pÄrĹŁilor verzi se face dupÄ  recoltarea rodului, pe la ĂŽnceputul lunii august. S-ar putea sÄ avem  nevoie Ĺi de tÄiere pentru a rÄri coroana. Deasemenea este recomandat,  ca crengile mai vechi de patru ani sÄ fie tÄiate, pentru ĂŽntinerirea  pÄrĹŁii productive.<br />        La viĹine, la creĹterea coroanei, trebuie avutÄ mare grijÄ la ĂŽnÄlĹŁimea trunchiului, deoarece trunchiul ĂŽnalt reduce cantitatea  rodului. ĂnÄlĹŁimea optimÄ a trunchiului se situeazÄ ĂŽn jurul a 90 cm. Ăn  funcĹŁia solului trebuie fÄcut o tÄiere mai pronunĹŁatÄ anual sau din doi ĂŽn doi ani. Crengile puternice Ĺi lungi, trebuie tÄiate anual, pentru a  ajuta ramificarea pomului. AtenĹŁie ĂŽnsÄ, la tÄierea la rod pentru  viĹine Ĺi cireĹe  nu trebuie sÄ exagerÄm, pentru cÄ duce la ĂŽndesarea  excesivÄ a coroanei.<br />       DacÄ aceste reguli fundamentale sĂŽnt respectate, vom observa ca  pomii noĹtri vor aduce roduri mai multe Ĺi mai bune calitativ. Nu  uitaĹŁi, orice produs intreĹŁinut corespunzÄtor asigurÄ un gust mai  plÄcut Ĺi este mult mai sÄnÄtos.</a></span>\r\n</div><br /><br style=\"text-align:center;\" /><img src=\"images/articles/m_4.jpg\" style=\"border:#0080FF 1px solid;\" alt=\"\"><br style=\"text-align:center;\" />    <br />\n<br />\n<!-- AddThis Button BEGIN -->\n<div class=\"addthis_toolbox addthis_default_style addthis_32x32_style\">\n<a class=\"addthis_button_preferred_1\"></a>\n<a class=\"addthis_button_preferred_2\"></a>\n<a class=\"addthis_button_preferred_3\"></a>\n<a class=\"addthis_button_preferred_4\"></a>\n<a class=\"addthis_button_compact\"></a>\n<a class=\"addthis_counter addthis_bubble_style\"></a>\n</div>\n\n\n<!-- AddThis Button END --></td>\n    <td id=\"right\">\n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" id=\"table_right\">\n  <tr>\n    <td><img src=\"images/main_calendar.jpg\" width=\"179\" height=\"20\" alt=\"\" /></td>\n  </tr>\n  <tr>\n    <td bgcolor=\"#7EB1EB\" id=\"table_right_content\">\n    <div class='right_title' align='center' style='text-transform:uppercase;'>Octombrie</div><div style=\"padding-bottom:5px; padding-top:5px;\" align=\"left\"><div style=\"border-top:#FFFFFF 1px dotted; padding-bottom:5px; padding-top:5px;\"></div><a href=\"showarticle.php?articleID=184\" class=\"link_white\" style=\"text-transform:capitalize; font-weight:bold;\">Octombrie</a></div><div align=\"justify\" style=\"font-size:10px;\">\r Plante de Exterior                       \tCulesul strugurilor                       \t                       \t                      \tPlante de Interior                       \tPregatirea plantelor pentru iarna       In viata romanilor, nu de multa vreme a luat nastere o zicala: iarna  nu-i ca vara.</div><div style=\"padding-top:5px;\" align=\"right\"><a href=\"showarticle.php?articleID=184\" class=\"link_white\" style=\"font-weight:bold;\">citeste mai mult ...</a></div></p>"
  },
  {
    "id": 95,
    "title": "Toamna se apropie de sfârșit, vine iarna, plantele de exterior, din grădini...",
    "category": "Plante de interior",
    "date": "09.03.2009",
    "views": 1572,
    "summary": "Toamna se apropie de sfârșit, vine iarna, plantele de exterior, din grădini sau balcoane, trebuie protejate de vremea rece. Plantele pot fi protejate prin Învelirea lor, dar nu cu folie, deoarece folia Împiedică aeris...",
    "content": "Toamna se apropie de sfârșit, vine iarna, plantele de exterior, din grădini sau balcoane, trebuie protejate de vremea rece. Plantele pot fi protejate prin Învelirea lor, dar nu cu folie, deoarece folia Împiedică aerisirea plantei, transpirația ei nu se mai poate evapora și riscă să Înghețe cu tot cu mladita verde. Pentru a evita acest ingheț nedorit, plantele tinere și cele care sunt foarte sensibile la frig pot fi inveliți cu materiale speciale, mai ales naturale, care nu Împiedică aerisirea și transpirația plantelor. Plantele mai mici și tineri pot fi protejate cel mai bine prin acoperirea lor cu un strat nu foarte gros de frunze sau crengi de conifere. Plantele de exterior care cresc În ghivece e bine să fie mutate la adăpost. Pentru cele care sunt dificil de deplasat, se protejează ghiveciul, de jur Împrejurul lui, se Înfășoară o folie protectoare sau cu rogojină de pai, astfel Încât În vasul respectiv să pătrundă cât mai puțină apă (din ploi sau din zăpadă), care ar putea Îngheța. Arbuștii, coniferele mici se Întăresc la bază, prin Înfășurarea unei sfori În jurul tulpinii lor. În jurul tulpinii se poate lega și sârma subțire. Această operațiune are ca scop protejarea plantei de greutățile mult prea mari (zăpadă) În timpul iernii. Pe timp de toamnă-iarnă, trebuie să scadă frecvența udărilor, pentru că plantele intră În perioada de repaus vegetativ. Nici Îngrășămintele nu se mai adaugă În cantități mari.",
    "html": "<br /><br><div align=\"justify\">\r\n<span style=\"font-family: verdana,arial,helvetica,sans-serif; font-size: medium;\"><a name=\"art_\">Toamna se apropie de sfĂ˘rĹit, vine iarna, plantele de exterior, din grÄdini sau balcoane, trebuie protejate de vremea rece. <br />  <br />  Plantele pot fi protejate prin ĂŽnvelirea lor, dar nu cu folie, deoarece  folia ĂŽmpiedicÄ aerisirea plantei, transpiraĹŁia ei nu se mai poate  evapora Ĺi riscÄ sÄ ĂŽngheĹŁe cu tot cu mladita verde. Pentru a evita  acest ingheĹŁ nedorit, plantele tinere Ĺi cele care sunt foarte  sensibile la frig pot fi inveliĹŁi cu materiale speciale, mai ales  naturale, care nu ĂŽmpiedicÄ aerisirea Ĺi transpiraĹŁia plantelor.  Plantele mai mici Ĺi tineri pot fi protejate cel mai bine prin  acoperirea lor cu un strat nu foarte gros de frunze sau crengi de  conifere.<br />  <br />  Plantele de exterior care cresc ĂŽn ghivece e bine sÄ fie mutate la  adÄpost. Pentru cele care sunt dificil de deplasat, se protejeazÄ  ghiveciul, de jur ĂŽmprejurul lui, se ĂŽnfÄĹoarÄ o folie protectoare sau  cu rogojinÄ de pai, astfel ĂŽncĂ˘t ĂŽn vasul respectiv sÄ pÄtrundÄ cĂ˘t  mai puĹŁinÄ apÄ (din ploi sau din zÄpadÄ), care ar putea ĂŽngheĹŁa. <br />  <br />  ArbuĹtii, coniferele mici se ĂŽntÄresc la bazÄ, prin ĂŽnfÄĹurarea unei  sfori ĂŽn jurul tulpinii lor. Ăn jurul tulpinii se poate lega Ĺi sĂ˘rma  subĹŁire. AceastÄ operaĹŁiune are ca scop protejarea plantei de  greutÄĹŁile mult prea mari (zÄpadÄ) ĂŽn timpul iernii. <br />  <br />  Pe timp de toamnÄ-iarnÄ, trebuie sÄ scadÄ frecvenĹŁa udÄrilor, pentru cÄ  plantele intrÄ ĂŽn perioada de repaus vegetativ. Nici ĂŽngrÄĹÄmintele nu  se mai adaugÄ ĂŽn cantitÄĹŁi mari. </a></span>\r\n</div><br /><br style=\"text-align:center;\" /><img src=\"images/articles/m_article_photo44.jpg\" style=\"border:#0080FF 1px solid;\" alt=\"\"><br style=\"text-align:center;\" />    <br />\n<br />\n<!-- AddThis Button BEGIN -->\n<div class=\"addthis_toolbox addthis_default_style addthis_32x32_style\">\n<a class=\"addthis_button_preferred_1\"></a>\n<a class=\"addthis_button_preferred_2\"></a>\n<a class=\"addthis_button_preferred_3\"></a>\n<a class=\"addthis_button_preferred_4\"></a>\n<a class=\"addthis_button_compact\"></a>\n<a class=\"addthis_counter addthis_bubble_style\"></a>\n</div>\n\n\n<!-- AddThis Button END --></td>\n    <td id=\"right\">\n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" id=\"table_right\">\n  <tr>\n    <td><img src=\"images/main_calendar.jpg\" width=\"179\" height=\"20\" alt=\"\" /></td>\n  </tr>\n  <tr>\n    <td bgcolor=\"#7EB1EB\" id=\"table_right_content\">\n    <div class='right_title' align='center' style='text-transform:uppercase;'>Octombrie</div><div style=\"padding-bottom:5px; padding-top:5px;\" align=\"left\"><div style=\"border-top:#FFFFFF 1px dotted; padding-bottom:5px; padding-top:5px;\"></div><a href=\"showarticle.php?articleID=184\" class=\"link_white\" style=\"text-transform:capitalize; font-weight:bold;\">Octombrie</a></div><div align=\"justify\" style=\"font-size:10px;\">\r Plante de Exterior                       \tCulesul strugurilor                       \t                       \t                      \tPlante de Interior                       \tPregatirea plantelor pentru iarna       In viata romanilor, nu de multa vreme a luat nastere o zicala: iarna  nu-i ca vara.</div><div style=\"padding-top:5px;\" align=\"right\"><a href=\"showarticle.php?articleID=184\" class=\"link_white\" style=\"font-weight:bold;\">citeste mai mult ...</a></div></p>"
  },
  {
    "id": 96,
    "title": "Meteorologii Încearcă să explice ce se Întâmplă cu vremea",
    "category": "Plante de interior",
    "date": "09.03.2009",
    "views": 1705,
    "summary": "Meteorologii Încearcă să explice ce se Întâmplă cu vremea. În ultima sută de ani Încălzirea a fost de două ori mai accentuată, iar În secolul următor această Încălzire ar putea avea efecte devastatoare. Aceste...",
    "content": "Meteorologii Încearcă să explice ce se Întâmplă cu vremea. În ultima sută de ani Încălzirea a fost de două ori mai accentuată, iar În secolul următor această Încălzire ar putea avea efecte devastatoare. Aceste efecte le simțim deja, deoarece temperaturile crescute din această iarnă au bătut recordurile din ultimii 50 de ani. Chiar dacă e greu de crezut, atât fenomenul de Încălzire globală, cât și efectul de seră sunt esențiale pentru existența vieții pe Pământ. Experții spun că atunci când soarele Încălzește planeta, anumite gaze din atmosferă se comportă precum pereții de sticlă a unei sere. Adică rețin căldura și mențin Pământul la o temperatură suficient de ridicată pentru a intrenține viața. Industrializarea intensă și defrisările necontrolate din ultimii ani sporesc, Însă, efectul gazelor de seră. Concentrațiile tot mai ridicate de vapori de apă, metan și dioxid de carbon izolează practic Pământul și nu mai permit eliminarea căldurii. Așa că planeta se Încinge din ce În ce mai tare. Rândunelele și gâștele sălbatice au uitat să migreze, insectele mediteraneene au ajuns până În Germania, iar unele plante au Înflorit prea devreme (ghiocelul): iarna blândă perturbă ciclurile naturale și furnizează Încă un indiciu al fenomenului de Încălzire globală. Păsările migratoare( gâște și rațe sălbatice) nu au nevoie să vină să ierneze la noi, doarece căldura din nord nu le obligă. Lacurile nu au Înghețat, au destulă mâncare și nu În ultimul rând trebuie să facă mai puțin efort. Pomii fructiferi, dar și vița de vie au Înmugurit, iar un eventual Îngheț ar putea distruge complet recolta de fructe din acest an. Meteorologii anunță o răcire a vremii ÎncepÎnd cu luna februarie, Însă prognoza În ceea ce privește precipitațiile este rezervată. Numai o minune poate salva, În acest an, agricultura din România. Căldura excesivă pentru această perioadă a anului și seceta deja instalată au compromis aproape În totalitate culturile de toamnă. Specialiștii susțin că pÎnă la un metru sub pămÎnt nu se găsește pic de apă. Din păcate În mare parte ploaia din zilele noastre nu ajută cu nimic plantele. Trebuie să plouă două săptămÎni ca să mai recoltăm ceva.",
    "html": "<br /><br><div align=\"justify\">\r\n<span style=\"font-family: verdana,arial,helvetica,sans-serif; font-size: medium;\"><a name=\"art_\">Meteorologii ĂŽncearcÄ sÄ explice  ce se ĂŽntĂ˘mplÄ cu vremea. Ăn ultima sutÄ de ani ĂŽncÄlzirea a fost de  douÄ ori mai accentuatÄ, iar ĂŽn secolul urmÄtor aceastÄ ĂŽncÄlzire ar  putea avea efecte devastatoare. Aceste efecte le simĹŁim deja, deoarece  temperaturile crescute din aceastÄ iarnÄ au bÄtut recordurile din  ultimii 50 de ani.<br />  <br />  Chiar dacÄ e greu de crezut, atĂ˘t fenomenul de ĂŽncÄlzire globalÄ, cĂ˘t Ĺi efectul de serÄ sunt esenĹŁiale pentru existenĹŁa vieĹŁii pe PÄmĂ˘nt.  ExperĹŁii spun cÄ atunci cĂ˘nd soarele ĂŽncÄlzeĹte planeta, anumite gaze  din atmosferÄ se comportÄ precum pereĹŁii de sticlÄ a unei sere. AdicÄ  reĹŁin cÄldura Ĺi menĹŁin PÄmĂ˘ntul la o temperaturÄ suficient de ridicatÄ  pentru a intrenĹŁine viaĹŁa.<br />  <br />  Industrializarea intensÄ Ĺi defrisÄrile necontrolate din ultimii ani  sporesc, ĂŽnsÄ, efectul gazelor de serÄ. ConcentraĹŁiile tot mai ridicate  de vapori de apÄ, metan Ĺi dioxid de carbon izoleazÄ practic PÄmĂ˘ntul Ĺi nu mai permit eliminarea cÄldurii. AĹa cÄ planeta se ĂŽncinge din ce ĂŽn ce mai tare. <br />  <br />  RĂ˘ndunelele Ĺi gĂ˘Ĺtele sÄlbatice au uitat sÄ migreze, insectele  mediteraneene au ajuns pĂ˘nÄ ĂŽn Germania, iar unele plante au ĂŽnflorit  prea devreme (ghiocelul): iarna blĂ˘ndÄ perturbÄ ciclurile naturale Ĺi  furnizeazÄ ĂŽncÄ un indiciu al fenomenului de ĂŽncÄlzire globalÄ.<br />  PÄsÄrile migratoare( gĂ˘Ĺte Ĺi raĹŁe sÄlbatice) nu au nevoie sÄ vinÄ sÄ  ierneze la noi, doarece cÄldura din nord nu le obligÄ. Lacurile nu au ĂŽngheĹŁat, au destulÄ mĂ˘ncare Ĺi nu ĂŽn ultimul rĂ˘nd  trebuie sÄ facÄ mai  puĹŁin efort.  <br />  <br />  Pomii fructiferi, dar Ĺi viĹŁa de vie au ĂŽnmugurit, iar un eventual ĂŽngheĹŁ ar putea distruge complet recolta de fructe din acest an.  Meteorologii anunĹŁÄ o rÄcire a vremii ĂŽncepĂŽnd cu luna februarie, ĂŽnsÄ  prognoza ĂŽn ceea ce priveĹte precipitaĹŁiile este rezervatÄ.<br />  <br />  Numai o minune poate salva, ĂŽn acest an, agricultura din RomĂ˘nia.  CÄldura excesivÄ pentru aceastÄ perioadÄ a anului Ĺi seceta deja  instalatÄ au compromis aproape ĂŽn totalitate culturile de toamnÄ.<br />  SpecialiĹtii susĹŁin cÄ pĂŽnÄ la un metru sub pÄmĂŽnt nu se gÄseĹte pic de apÄ. Din pÄcate ĂŽn mare parte ploaia din zilele noastre nu  ajutÄ cu nimic plantele. <br />  Trebuie sÄ plouÄ douÄ sÄptÄmĂŽni ca sÄ mai recoltÄm ceva.</a></span>\r\n</div><br /><br style=\"text-align:center;\" /><img src=\"images/articles/m_article_photo144-0.jpg\" style=\"border:#0080FF 1px solid;\" alt=\"\"><br style=\"text-align:center;\" /><br style=\"text-align:center;\" /><img src=\"images/articles/m_article_photo144_1-0.jpg\" style=\"border:#0080FF 1px solid;\" alt=\"\"><br style=\"text-align:center;\" />    <br />\n<br />\n<!-- AddThis Button BEGIN -->\n<div class=\"addthis_toolbox addthis_default_style addthis_32x32_style\">\n<a class=\"addthis_button_preferred_1\"></a>\n<a class=\"addthis_button_preferred_2\"></a>\n<a class=\"addthis_button_preferred_3\"></a>\n<a class=\"addthis_button_preferred_4\"></a>\n<a class=\"addthis_button_compact\"></a>\n<a class=\"addthis_counter addthis_bubble_style\"></a>\n</div>\n\n\n<!-- AddThis Button END --></td>\n    <td id=\"right\">\n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" id=\"table_right\">\n  <tr>\n    <td><img src=\"images/main_calendar.jpg\" width=\"179\" height=\"20\" alt=\"\" /></td>\n  </tr>\n  <tr>\n    <td bgcolor=\"#7EB1EB\" id=\"table_right_content\">\n    <div class='right_title' align='center' style='text-transform:uppercase;'>Octombrie</div><div style=\"padding-bottom:5px; padding-top:5px;\" align=\"left\"><div style=\"border-top:#FFFFFF 1px dotted; padding-bottom:5px; padding-top:5px;\"></div><a href=\"showarticle.php?articleID=184\" class=\"link_white\" style=\"text-transform:capitalize; font-weight:bold;\">Octombrie</a></div><div align=\"justify\" style=\"font-size:10px;\">\r Plante de Exterior                       \tCulesul strugurilor                       \t                       \t                      \tPlante de Interior                       \tPregatirea plantelor pentru iarna       In viata romanilor, nu de multa vreme a luat nastere o zicala: iarna  nu-i ca vara.</div><div style=\"padding-top:5px;\" align=\"right\"><a href=\"showarticle.php?articleID=184\" class=\"link_white\" style=\"font-weight:bold;\">citeste mai mult ...</a></div></p>"
